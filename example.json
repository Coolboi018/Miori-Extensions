{
  "contractVersion": 1,
  "id": "example",
  "label": "Example Source",
  "version": "0.1.0",
  "capabilities": { "subtitles": false, "skipMarkers": false, "thumbnails": false },
  "match": { "probe": "episodes", "minItems": 1 },
  "episodes": {
    "url": "https://example.com/api/anime/{anilistId}/episodes?page={page}",
    "headers": { "User-Agent": "{ua}", "Accept": "application/json" },
    "paging": { "param": "page", "start": 1, "stopWhen": "items.length==0", "cap": 30 },
    "map": {
      "number": "$.number",
      "title": "$.title",
      "poster": { "path": "$.poster", "transform": "tmdb-w500" },
      "synopsis": "$.synopsis"
    },
    "dedupeBy": "number",
    "emptyIsFailure": true
  },
  "resolve": {
    "url": "https://example.com/api/stream?anilist={anilistId}&ep={ep}",
    "headers": { "User-Agent": "{ua}", "Accept": "application/json" },
    "stream": { "jsonPath": "$.streamUrl" },
    "container": "auto",
    "quality": "Example",
    "subtitles": {
      "path": "$.subtitles",
      "url": "$.url",
      "label": "$.label",
      "lang": "$.lang"
    },
    "intro": "$.intro",
    "outro": "$.outro",
    "signed": false
  }
}